{
  "name": "abc-react-native-sso-login",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "yarn workspace mobile start",
    "android": "yarn workspace mobile android",
    "ios": "yarn workspace mobile ios",
    "web": "yarn workspace mobile web",
    "lint": "yarn workspace mobile lint",
    "api": "yarn workspace api dev",
    "mobile": "yarn workspace mobile start",
    "dev": "concurrently -k -n api,mobile -c blue,green \"yarn api\" \"yarn mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
